PORT=3000

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=../secrets/scolarix-447f2-firebase-adminsdk.json

# Optionnel : sans MAIL_HOST, les emails (relances de paiement) sont
# journalisés au lieu d'être envoyés — utile en développement.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@scolarix.app
